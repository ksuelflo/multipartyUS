annotate("text",
x = 70,
y = -1.75,
label = str_c("rate = ", format(slope_PETM/1000, scientific = FALSE), "‰/yr"),
size = 4,
fontface = "bold")+
theme_minimal()+
labs(title="δ13C during the PETM", subtitle="Data from Jiang et al. 2025", x="kyr relative to onset of PETM", y="δ13C ‰", color="Phase") +
scale_color_manual(
values = c(
"PETM" = "#0072B2",
"PETM onset" = "#009E73",
"NoPhase" = "darkgray"
),
breaks = c("PETM onset", "PETM")) +
theme(plot.title = element_text(face = "bold"))
